# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Public site URL (OAuth redirect fallback + production callbacks)
NEXT_PUBLIC_APP_URL=https://prompt-vault-tan.vercel.app

# SiteForge Academy (לימודים mode + SSO return target)
NEXT_PUBLIC_ACADEMY_URL=https://siteforge-mu-five.vercel.app

# Comma-separated admin emails (case-insensitive). Include 091 admin:
ADMIN_EMAILS=wkhn091@gmail.com
# Same list for UI gating (coin prices free, vault admin tools)
NEXT_PUBLIC_ADMIN_EMAILS=wkhn091@gmail.com

# MCP auth (all clients: Claude, Cursor, ChatGPT, VS Code, …)
# OAuth 2.1 + PKCE + DCR is always on at /api/oauth/* and /.well-known/*
# Optional shared Bearer key (also grants mcp:premium without browser sign-in):
# MCP_API_KEY=generate-a-long-random-secret
# Optional dedicated HMAC secret for OAuth JWTs (falls back to MCP_API_KEY / service role):
# MCP_OAUTH_SECRET=generate-another-long-random-secret

# Auth (all methods live on /login):
# - Email + password (sign in only — signup UI removed)
# - Magic link (OTP email, shouldCreateUser: false)
# - Password reset (min 12 chars)
# - Google / Apple / GitHub OAuth
#
# Manual Supabase steps (shared project for Vault + SiteForge SSO):
# 1) Authentication → Providers → Email → disable "Allow new users to sign up"
# 2) Enable Google / GitHub / Apple providers with Client ID + Secret
# 3) URL Configuration Site URL = NEXT_PUBLIC_APP_URL (Vault)
# 4) Redirect URLs must include BOTH apps:
#      https://prompt-vault-tan.vercel.app/auth/callback
#      https://siteforge-mu-five.vercel.app/auth/callback
#      http://localhost:3000/auth/callback
#      http://localhost:3001/auth/callback
# 5) Same NEXT_PUBLIC_SUPABASE_URL + ANON_KEY on Vault and SiteForge
# 6) Run supabase/migrations/20260318140000_secure_prompts.sql
#
# Login collects full name + phone before Connect/OAuth; values go to
# user_metadata (full_name, phone). Admin emails skip that gate.
