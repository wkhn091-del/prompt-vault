# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional public site URL (OAuth redirect fallback)
# NEXT_PUBLIC_APP_URL=https://prompt-vault-tan.vercel.app

# Social login (Google / Apple / GitHub): enable each provider in
# Supabase → Authentication → Providers, add redirect URL
#   https://YOUR_DOMAIN/auth/callback
# then set SHOW_SOCIAL_LOGIN=true in src/lib/auth-oauth.ts (UI is hidden by default).
