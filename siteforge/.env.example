# Names only — put real values in .env.local (never commit secrets)

# Same Supabase project as Prompt Vault (SSO / shared Google account)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public URLs
NEXT_PUBLIC_SITE_URL=https://siteforge-mu-five.vercel.app
NEXT_PUBLIC_VAULT_URL=https://prompt-vault-tan.vercel.app
NEXT_PUBLIC_MAIN_SITE_URL=

# Admin 091 — unlocks all stages/medals (must match Vault)
ADMIN_EMAILS=wkhn091@gmail.com
NEXT_PUBLIC_ADMIN_EMAILS=wkhn091@gmail.com

# Optional: unlock everything for all users (local/dev only)
# NEXT_PUBLIC_ACADEMY_UNLOCK_ALL=true

# Course access codes / certs (legacy)
ACCESS_CODES=sites:CHANGE_ME,agents:CHANGE_ME,all:CHANGE_ME
SESSION_SECRET=
CERT_SECRET=

# Supabase Redirect URLs (Authentication → URL Configuration) must include:
#   https://siteforge-mu-five.vercel.app/auth/callback
#   http://localhost:3001/auth/callback
# plus the Vault callbacks listed in the root .env.example
